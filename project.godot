; Engine configuration file.
config_version=5

[application]

config/name="슬라임 인공생명 실험실"
config/description="슬라임 무리의 생태·진화·문명 발견을 관찰하는 연구용 시뮬레이션"
config/version="0.1.0"
config/use_custom_user_dir=true
config/custom_user_dir_name="slime-lab"
run/main_scene="res://scenes/lab.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[gui]

theme/custom_font="res://assets/fonts/NanumGothic-Regular.ttf"
